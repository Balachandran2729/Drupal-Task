        'not null' => TRUE,
        'default' => 0,
      ],

      'sales' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],

      'offer' => [
        'type' => 'numeric',
        'precision' => 5,
        'scale' => 2,
        'not null' => TRUE,
        'default' => 0,
      ],

      'amount' => [
        'type' => 'numeric',
        'precision' => 10,

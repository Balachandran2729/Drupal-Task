    'fields' => [

      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],

      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],

      'status' => [
        'type' => 'int',
